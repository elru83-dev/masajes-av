# WhatsApp del desarrollador para el link "Powered by @RuloOo" del footer
NEXT_PUBLIC_DEV_WHATSAPP=549XXXXXXXXXX

# Google Calendar (opcional: sin esto la agenda funciona igual, sin sincronizar)
GOOGLE_CALENDAR_ID=av.masajes.integrales@gmail.com
# Pegá acá el contenido COMPLETO del archivo JSON de la cuenta de servicio, desde { hasta }
GOOGLE_SA_JSON=
# (Alternativa a GOOGLE_SA_JSON: GOOGLE_SA_EMAIL + GOOGLE_SA_PRIVATE_KEY por separado)

# Aviso por mail de pedidos nuevos (opcional, gratis con Gmail)
GMAIL_USER=av.masajes.integrales@gmail.com
# Contraseña de aplicación de 16 letras (myaccount.google.com/apppasswords), NO la clave de la cuenta
GMAIL_APP_PASSWORD=
# Destino del aviso (si se deja vacío, le llega a GMAIL_USER)
NOTIFY_EMAIL_TO=
# URL pública del sitio, para el botón "Abrir panel" del mail
NEXT_PUBLIC_SITE_URL=https://tu-sitio.vercel.app
